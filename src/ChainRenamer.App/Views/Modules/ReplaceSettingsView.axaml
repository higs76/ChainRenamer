<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ChainRenamer.App.ViewModels.Modules"
             xmlns:res="using:ChainRenamer.App.Resources"
             x:Class="ChainRenamer.App.Views.Modules.ReplaceSettingsView"
             x:DataType="vm:ReplaceSettingsViewModel">
    <StackPanel Spacing="8">
        <Grid ColumnDefinitions="*,16,*" RowDefinitions="Auto,Auto">
            <TextBlock Text="{x:Static res:Strings.Replace_Find}" />
            <TextBlock Grid.Column="2" Text="{x:Static res:Strings.Replace_With}" />
            <TextBox Grid.Row="1" Text="{Binding Find}" FontFamily="Consolas,monospace" />
            <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding ReplaceWith}" FontFamily="Consolas,monospace" />
        </Grid>
        <WrapPanel>
            <CheckBox Margin="0,0,24,0" IsChecked="{Binding UseRegex}" Content="{x:Static res:Strings.Replace_Regex}" />
            <CheckBox Margin="0,0,24,0" IsChecked="{Binding MatchCase}" Content="{x:Static res:Strings.Replace_MatchCase}" />
            <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" Text="{x:Static res:Strings.Replace_Part}" />
            <ComboBox ItemsSource="{Binding Parts}" SelectedValue="{Binding Part}"
                      SelectedValueBinding="{Binding Value, x:DataType=vm:PartChoice}"
                      DisplayMemberBinding="{Binding Label, x:DataType=vm:PartChoice}" />
        </WrapPanel>
    </StackPanel>
</UserControl>
