<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ChainRenamer.App.ViewModels.Modules"
             xmlns:res="using:ChainRenamer.App.Resources"
             x:Class="ChainRenamer.App.Views.Modules.ReplaceSettingsView"
             x:DataType="vm:ReplaceSettingsViewModel">
    <!-- Reads as a sentence: Replace the text [____] with [____] -->
    <StackPanel Spacing="8">
        <Grid ColumnDefinitions="Auto,*,Auto,*" ColumnSpacing="8">
            <TextBlock VerticalAlignment="Center" Text="{x:Static res:Strings.Replace_Find}" />
            <TextBox Grid.Column="1" Text="{Binding Find}" FontFamily="Consolas,monospace" />
            <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="{x:Static res:Strings.Replace_With}" />
            <TextBox Grid.Column="3" Text="{Binding ReplaceWith}" FontFamily="Consolas,monospace" />
        </Grid>
        <WrapPanel>
            <CheckBox Margin="0,0,24,0" IsChecked="{Binding MatchCase}" Content="{x:Static res:Strings.Replace_MatchCase}" />
            <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" Text="{x:Static res:Strings.Replace_Occurrence}" />
            <ComboBox ItemsSource="{Binding Occurrences}" SelectedValue="{Binding Occurrence}"
                      SelectedValueBinding="{Binding Value, x:DataType=vm:OccurrenceChoice}"
                      DisplayMemberBinding="{Binding Label, x:DataType=vm:OccurrenceChoice}" />
        </WrapPanel>
        <TextBlock Text="{x:Static res:Strings.Replace_Hint}" Opacity="0.7" FontSize="12" />
    </StackPanel>
</UserControl>
