<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ChainRenamer.App.ViewModels.Modules"
             xmlns:res="using:ChainRenamer.App.Resources"
             x:Class="ChainRenamer.App.Views.Modules.PadNumbersSettingsView"
             x:DataType="vm:PadNumbersSettingsViewModel">
    <!-- Reads as a sentence: Pad [every number] to [2] digits -->
    <StackPanel Spacing="8">
        <WrapPanel>
            <TextBlock VerticalAlignment="Center" Margin="0,0,8,0" Text="{x:Static res:Strings.PadNumbers_Which}" />
            <ComboBox ItemsSource="{Binding Choices}" SelectedValue="{Binding Which}" MinWidth="200" Margin="0,0,16,0"
                      SelectedValueBinding="{Binding Value, x:DataType=vm:Choice}" DisplayMemberBinding="{Binding Label, x:DataType=vm:Choice}" />
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,16,0">
                <TextBlock VerticalAlignment="Center" Text="{x:Static res:Strings.PadNumbers_Digits}" />
                <NumericUpDown Value="{Binding Digits}" Minimum="1" Maximum="12" Increment="1" FormatString="0" Width="130" IsEnabled="{Binding IsFixed}" />
            </StackPanel>
            <CheckBox VerticalAlignment="Center" IsChecked="{Binding Automatic}" Content="{x:Static res:Strings.PadNumbers_Automatic}" />
        </WrapPanel>
        <CheckBox IsChecked="{Binding TrimZeros}" Content="{x:Static res:Strings.PadNumbers_TrimZeros}" />
    </StackPanel>
</UserControl>
