<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ChainRenamer.App.ViewModels.Modules"
             xmlns:res="using:ChainRenamer.App.Resources"
             x:Class="ChainRenamer.App.Views.Modules.RegexReplaceSettingsView"
             x:DataType="vm:RegexReplaceSettingsViewModel">
    <StackPanel Spacing="8">
        <Grid ColumnDefinitions="*,16,*" RowDefinitions="Auto,Auto">
            <TextBlock Text="{x:Static res:Strings.Regex_Pattern}" />
            <TextBlock Grid.Column="2" Text="{x:Static res:Strings.Regex_With}" />
            <TextBox Grid.Row="1" Text="{Binding Pattern}" FontFamily="Consolas,monospace" />
            <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding ReplaceWith}" FontFamily="Consolas,monospace" />
        </Grid>
        <CheckBox IsChecked="{Binding MatchCase}" Content="{x:Static res:Strings.Replace_MatchCase}" />
    </StackPanel>
</UserControl>
