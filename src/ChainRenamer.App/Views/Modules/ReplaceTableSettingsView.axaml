<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ChainRenamer.App.ViewModels.Modules"
             xmlns:res="using:ChainRenamer.App.Resources"
             x:Class="ChainRenamer.App.Views.Modules.ReplaceTableSettingsView"
             x:DataType="vm:ReplaceTableSettingsViewModel">
    <StackPanel Spacing="8">
        <Grid ColumnDefinitions="32,*,32,*,40" Margin="0,0,16,0">
            <TextBlock Grid.Column="1" Text="{x:Static res:Strings.ReplaceTable_Find}" />
            <TextBlock Grid.Column="3" Text="{x:Static res:Strings.ReplaceTable_With}" />
        </Grid>

        <!-- A long table scrolls within the panel -->
        <ScrollViewer MaxHeight="190">
            <ItemsControl ItemsSource="{Binding Pairs}" Margin="0,0,16,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ReplacePairViewModel">
                        <Grid ColumnDefinitions="32,*,32,*,40" Margin="0,0,0,4">
                            <CheckBox IsChecked="{Binding Enabled}" ToolTip.Tip="{x:Static res:Strings.ReplaceTable_Enabled}" />
                            <TextBox Grid.Column="1" Text="{Binding Find}" FontFamily="Consolas,monospace" />
                            <TextBlock Grid.Column="2" Text="→" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.6" />
                            <TextBox Grid.Column="3" Text="{Binding ReplaceWith}" FontFamily="Consolas,monospace" />
                            <Button Grid.Column="4" Content="✕" Command="{Binding RemoveCommand}" HorizontalAlignment="Right"
                                    Background="Transparent" ToolTip.Tip="{x:Static res:Strings.ReplaceTable_Remove}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <WrapPanel>
            <Button Content="{x:Static res:Strings.ReplaceTable_Add}" Command="{Binding AddLineCommand}" Margin="0,0,8,0" />
            <Button Content="{x:Static res:Strings.ReplaceTable_Paste}" Click="OnPaste" Margin="0,0,8,0" />
            <Button Content="{x:Static res:Strings.ReplaceTable_Load}" Click="OnLoad" Margin="0,0,8,0" />
            <Button Content="{x:Static res:Strings.ReplaceTable_Save}" Click="OnSave" Margin="0,0,24,0" />
            <CheckBox VerticalAlignment="Center" IsChecked="{Binding MatchCase}" Content="{x:Static res:Strings.Replace_MatchCase}" />
        </WrapPanel>
        <TextBlock Text="{x:Static res:Strings.ReplaceTable_Hint}" Opacity="0.7" TextWrapping="Wrap" />
    </StackPanel>
</UserControl>
