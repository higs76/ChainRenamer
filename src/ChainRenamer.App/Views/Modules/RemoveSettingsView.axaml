<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ChainRenamer.App.ViewModels.Modules"
             xmlns:res="using:ChainRenamer.App.Resources"
             x:Class="ChainRenamer.App.Views.Modules.RemoveSettingsView"
             x:DataType="vm:RemoveSettingsViewModel">
    <!-- Reads as a sentence: Remove [the first characters] Number [4] -->
    <StackPanel Spacing="8">
        <WrapPanel>
            <TextBlock VerticalAlignment="Center" Margin="0,0,8,0" Text="{x:Static res:Strings.Remove_What}" />
            <ComboBox ItemsSource="{Binding Choices}" SelectedValue="{Binding What}" MinWidth="240" Margin="0,0,16,0"
                      SelectedValueBinding="{Binding Value, x:DataType=vm:Choice}" DisplayMemberBinding="{Binding Label, x:DataType=vm:Choice}" />

            <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsCount}">
                <TextBlock VerticalAlignment="Center" Text="{x:Static res:Strings.Remove_Count}" />
                <NumericUpDown Value="{Binding Count}" Minimum="0" Increment="1" FormatString="0" Width="130" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsRange}">
                <TextBlock VerticalAlignment="Center" Text="{x:Static res:Strings.Remove_From}" />
                <NumericUpDown Value="{Binding From}" Increment="1" FormatString="0" Width="130" />
                <TextBlock VerticalAlignment="Center" Text="{x:Static res:Strings.Remove_To}" />
                <NumericUpDown Value="{Binding To}" Increment="1" FormatString="0" Width="130" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsAround}">
                <TextBlock VerticalAlignment="Center" Text="{x:Static res:Strings.Remove_Text}" />
                <TextBox Text="{Binding Text}" Width="200" FontFamily="Consolas,monospace" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsBetween}">
                <TextBlock VerticalAlignment="Center" Text="{x:Static res:Strings.Remove_Start}" />
                <TextBox Text="{Binding Text}" Width="120" FontFamily="Consolas,monospace" />
                <TextBlock VerticalAlignment="Center" Text="{x:Static res:Strings.Remove_End}" />
                <TextBox Text="{Binding EndText}" Width="120" FontFamily="Consolas,monospace" />
            </StackPanel>
        </WrapPanel>

        <TextBlock Text="{x:Static res:Strings.Remove_RangeHint}" Opacity="0.7" IsVisible="{Binding IsRange}" />

        <WrapPanel IsVisible="{Binding IsText}">
            <CheckBox Margin="0,0,24,0" IsChecked="{Binding IncludeText}" Content="{x:Static res:Strings.Remove_IncludeText}" />
            <CheckBox Margin="0,0,24,0" IsChecked="{Binding LastOccurrence}" Content="{x:Static res:Strings.Remove_Last}" IsVisible="{Binding IsAround}" />
            <CheckBox IsChecked="{Binding MatchCase}" Content="{x:Static res:Strings.Replace_MatchCase}" />
        </WrapPanel>
    </StackPanel>
</UserControl>
