<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ChainRenamer.App.ViewModels.Modules"
             xmlns:res="using:ChainRenamer.App.Resources"
             x:Class="ChainRenamer.App.Views.Modules.InsertSettingsView"
             x:DataType="vm:InsertSettingsViewModel">
    <!-- Reads as a sentence: Insert the text [____] [after a text] [ - ] -->
    <StackPanel Spacing="8">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
            <TextBlock VerticalAlignment="Center" Text="{x:Static res:Strings.Insert_Text}" />
            <TextBox Grid.Column="1" Text="{Binding Text}" FontFamily="Consolas,monospace" />
            <ComboBox Grid.Column="2" ItemsSource="{Binding Choices}" SelectedValue="{Binding Where}" MinWidth="240"
                      SelectedValueBinding="{Binding Value, x:DataType=vm:Choice}" DisplayMemberBinding="{Binding Label, x:DataType=vm:Choice}" />
        </Grid>
        <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsPosition}">
            <TextBlock VerticalAlignment="Center" Text="{x:Static res:Strings.Insert_Position}" />
            <NumericUpDown Value="{Binding Position}" Increment="1" FormatString="0" Width="130" />
            <TextBlock VerticalAlignment="Center" Text="{x:Static res:Strings.Insert_PositionHint}" Opacity="0.7" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsAnchor}">
            <TextBlock VerticalAlignment="Center" Text="{x:Static res:Strings.Insert_Anchor}" />
            <TextBox Text="{Binding Anchor}" Width="200" FontFamily="Consolas,monospace" />
            <CheckBox Margin="16,0,0,0" IsChecked="{Binding MatchCase}" Content="{x:Static res:Strings.Replace_MatchCase}" />
        </StackPanel>
    </StackPanel>
</UserControl>
