<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ChainRenamer.App.ViewModels"
        xmlns:res="using:ChainRenamer.App.Resources"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="750"
        x:Class="ChainRenamer.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="{Binding Title}"
        Width="1280" Height="800">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Window.Styles>
        <!-- A block of the chain column -->
        <Style Selector="Border.step">
            <Setter Property="Padding" Value="4,6" />
        </Style>
        <!-- A disabled step must be obvious: faded, title struck through, pause icon -->
        <Style Selector="Border.step.disabled">
            <Setter Property="Opacity" Value="0.45" />
        </Style>
        <Style Selector="Border.step.disabled TextBlock.title">
            <Setter Property="TextDecorations" Value="Strikethrough" />
        </Style>
        <Style Selector="Button.tool">
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <!-- Drag handle: grab it to move a step or a file (see MainWindow.axaml.cs) -->
        <Style Selector="TextBlock.handle">
            <Setter Property="Text" Value="≡" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="SizeNorthSouth" />
            <Setter Property="Opacity" Value="0.8" />
        </Style>
        <!-- Hovering a step block or a handle highlights the handle in the accent color -->
        <Style Selector="ListBoxItem:pointerover TextBlock.handle, TextBlock.handle:pointerover">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource SystemAccentColor}" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>

        <!-- Preview grid -->
        <Style Selector="TextBlock.header">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style Selector="TextBlock.cell">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="8,0" />
        </Style>
        <Style Selector="TextBlock.changed">
            <Setter Property="Foreground" Value="{DynamicResource SystemAccentColor}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBlock.excluded">
            <Setter Property="Opacity" Value="0.45" />
            <Setter Property="TextDecorations" Value="Strikethrough" />
        </Style>

        <!-- Skipped by the selected name step: kept as it is, but still renamed by the other steps -->
        <Style Selector="TextBlock.skipped">
            <Setter Property="Opacity" Value="0.45" />
            <Setter Property="FontStyle" Value="Italic" />
        </Style>

        <Style Selector="Border.banner">
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Background" Value="#33FFB900" />
        </Style>
        <Style Selector="Border.banner.error">
            <Setter Property="Background" Value="#33E81123" />
        </Style>
        <Style Selector="TextBlock.conflict">
            <Setter Property="Foreground" Value="#E81123" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.status.error">
            <Setter Property="Foreground" Value="#E81123" />
        </Style>
    </Window.Styles>

    <DockPanel>
    <!-- Top bar: status or confirmation on the left, apply and undo on the right -->
    <Border DockPanel.Dock="Top" Padding="12,8" Background="{DynamicResource SystemControlBackgroundBaseLowBrush}">
        <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
                <Button Content="{x:Static res:Strings.Undo}" Command="{Binding UndoCommand}"
                        IsVisible="{Binding LastJournal, Converter={x:Static ObjectConverters.IsNotNull}}" />
                <Button Classes="accent" Content="{x:Static res:Strings.Apply}" Command="{Binding ApplyCommand}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="12" IsVisible="{Binding IsConfirming}">
                <TextBlock Text="{Binding ConfirmText}" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Button Classes="accent" Content="{x:Static res:Strings.Apply_Yes}" Command="{Binding ConfirmApplyCommand}" />
                <Button Content="{x:Static res:Strings.Apply_No}" Command="{Binding CancelApplyCommand}" />
            </StackPanel>
            <TextBlock Classes="status" Classes.error="{Binding StatusIsError}" Text="{Binding Status}"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Status}"
                       IsVisible="{Binding !IsConfirming}" />
        </DockPanel>
    </Border>

    <Grid ColumnDefinitions="320,Auto,*">

        <!-- Left: the chain of modules, top to bottom in execution order -->
        <DockPanel Margin="8">
            <Button DockPanel.Dock="Bottom" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    Margin="0,8,0,0" Content="{x:Static res:Strings.AddModule}">
                <Button.Flyout>
                    <MenuFlyout ItemsSource="{Binding AddEntries}">
                        <MenuFlyout.ItemContainerTheme>
                            <ControlTheme TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}"
                                          x:DataType="vm:AddModuleEntry">
                                <Setter Property="Header" Value="{Binding Title}" />
                                <Setter Property="Command" Value="{Binding Command}" />
                            </ControlTheme>
                        </MenuFlyout.ItemContainerTheme>
                    </MenuFlyout>
                </Button.Flyout>
            </Button>

            <TextBlock DockPanel.Dock="Top" Text="{x:Static res:Strings.Chain_Title}" FontSize="16" FontWeight="SemiBold" Margin="4,0,0,8" />
            <!-- Reminder that steps can be moved, as soon as there are two of them -->
            <TextBlock DockPanel.Dock="Bottom" Text="{x:Static res:Strings.Chain_Hint}" IsVisible="{Binding CanReorder}"
                       TextWrapping="Wrap" FontSize="12" Opacity="0.7" Margin="4,8,4,0" />

            <ListBox x:Name="StepList" ItemsSource="{Binding Steps}" SelectedItem="{Binding SelectedStep}">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:StepViewModel">
                        <Border Classes="step" Classes.disabled="{Binding !IsEnabled}">
                            <Grid ColumnDefinitions="28,32,*,Auto">
                                <!-- The source is fixed: no handle, no remove button -->
                                <TextBlock Classes="handle" IsVisible="{Binding !IsSource}" ToolTip.Tip="{x:Static res:Strings.Step_Drag}" />
                                <TextBlock Grid.Column="1" Text="{Binding Number}" FontSize="22" FontWeight="Light" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Classes="title" Text="{Binding Title}" FontWeight="SemiBold" />
                                        <TextBlock Text="⏸" IsVisible="{Binding !IsEnabled}" />
                                        <TextBlock Text="⚠" Foreground="#E81123" ToolTip.Tip="{Binding Error}"
                                                   IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding Name}" FontStyle="Italic" TextTrimming="CharacterEllipsis"
                                               IsVisible="{Binding Name, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                    <TextBlock Text="{Binding Status}" FontSize="12" Opacity="0.7" />
                                </StackPanel>
                                <Button Grid.Column="3" Classes="tool" Content="✕" IsVisible="{Binding !IsSource}"
                                        ToolTip.Tip="{x:Static res:Strings.RemoveStep}"
                                        Command="{Binding #StepList.((vm:MainViewModel)DataContext).RemoveStepCommand}" CommandParameter="{Binding}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <GridSplitter Grid.Column="1" Width="4" ResizeDirection="Columns" />

        <!-- Right: preview on top, settings of the selected step below -->
        <Grid Grid.Column="2" RowDefinitions="Auto,Auto,*,Auto" Margin="8">
            <DockPanel Margin="0,0,0,6">
                <CheckBox DockPanel.Dock="Right" IsChecked="{Binding ShowOriginal}" Content="{x:Static res:Strings.ShowOriginal}" FontSize="12" />
                <TextBlock Text="{Binding Summary}" Opacity="0.8" VerticalAlignment="Center" />
            </DockPanel>

            <Border Grid.Row="1" Classes="banner" Classes.error="{Binding BannerIsError}"
                    IsVisible="{Binding Banner, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <TextBlock Text="{Binding Banner}" TextWrapping="Wrap" />
            </Border>

            <DataGrid x:Name="PreviewGrid" Grid.Row="2" ItemsSource="{Binding Rows}" AutoGenerateColumns="False"
                      CanUserSortColumns="False" CanUserReorderColumns="False"
                      GridLinesVisibility="Horizontal" HeadersVisibility="Column" SelectionMode="Extended">
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="{x:Static res:Strings.Select_Check}" Command="{Binding CheckSelectionCommand}" InputGesture="Space" />
                        <MenuItem Header="{x:Static res:Strings.Select_Uncheck}" Command="{Binding UncheckSelectionCommand}" />
                        <MenuItem Header="{x:Static res:Strings.Select_Invert}" Command="{Binding InvertChecksCommand}" />
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.Columns>
                    <!-- Check box (source step: included; name step: applied), or handle to place the file by hand (sort step) -->
                    <DataGridTemplateColumn Width="48">
                        <DataGridTemplateColumn.Header>
                            <!-- The header keeps 12 px on the left and 32 px for a sort icon on the right: negative margins give the check box the whole column back. -->
                            <CheckBox MinWidth="0" Padding="0" Margin="-12,0,-32,0" HorizontalAlignment="Center"
                                      IsChecked="{Binding #PreviewGrid.((vm:MainViewModel)DataContext).AllChecked}"
                                      IsVisible="{Binding #PreviewGrid.((vm:MainViewModel)DataContext).CanCheck}"
                                      ToolTip.Tip="{x:Static res:Strings.Check_All}" />
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="vm:PreviewRow">
                                <Panel HorizontalAlignment="Center">
                                    <CheckBox IsChecked="{Binding IsChecked}" IsEnabled="{Binding CanCheck}" IsVisible="{Binding !CanMove}"
                                              ToolTip.Tip="{Binding #PreviewGrid.((vm:MainViewModel)DataContext).CheckTip}" />
                                    <TextBlock Classes="handle" IsVisible="{Binding CanMove}" ToolTip.Tip="{x:Static res:Strings.Row_Drag}" />
                                </Panel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Width="*">
                        <DataGridTemplateColumn.Header>
                            <TextBlock Classes="header" Text="{x:Static res:Strings.Column_Original}" ToolTip.Tip="{x:Static res:Strings.Column_Original_Tip}" />
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="vm:PreviewRow">
                                <TextBlock Classes="cell" Text="{Binding Original}" Opacity="0.7" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Width="*">
                        <DataGridTemplateColumn.Header>
                            <TextBlock Classes="header" Text="{Binding #PreviewGrid.((vm:MainViewModel)DataContext).BeforeHeader}" ToolTip.Tip="{x:Static res:Strings.Column_Before_Tip}" />
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="vm:PreviewRow">
                                <TextBlock Classes="cell" Classes.excluded="{Binding !IsIncluded}" Classes.skipped="{Binding IsSkipped}" Text="{Binding Before}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Width="*">
                        <DataGridTemplateColumn.Header>
                            <TextBlock Classes="header" Text="{Binding #PreviewGrid.((vm:MainViewModel)DataContext).AfterHeader}" ToolTip.Tip="{x:Static res:Strings.Column_After_Tip}" />
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="vm:PreviewRow">
                                <StackPanel Orientation="Horizontal" ToolTip.Tip="{Binding Conflict}">
                                    <TextBlock Classes="cell" Classes.changed="{Binding IsChanged}" Classes.conflict="{Binding HasConflict}" Classes.skipped="{Binding IsSkipped}"
                                               Text="{Binding After}" />
                                    <TextBlock Classes="conflict" Text="{Binding Conflict, StringFormat='⚠ {0}'}" IsVisible="{Binding HasConflict}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Settings of the selected step -->
            <Border Grid.Row="3" Margin="0,8,0,0" Padding="12" CornerRadius="4" MinHeight="180"
                    Background="{DynamicResource SystemControlBackgroundBaseLowBrush}">
                <StackPanel DataContext="{Binding SelectedStep}" x:DataType="vm:StepViewModel" Spacing="10">
                    <!-- The step itself: title, enabled, optional name. Kept apart from the module settings below,
                         so that the name field is not mistaken for a setting ("Replace [ ___ ]"). -->
                    <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                        <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="24,0,0,0"
                                    IsVisible="{Binding !IsSource}">
                            <TextBlock Text="{x:Static res:Strings.Step_NameLabel}" VerticalAlignment="Center" Opacity="0.7" FontSize="12" />
                            <TextBox Width="240" FontSize="12" Text="{Binding Name}"
                                     PlaceholderText="{x:Static res:Strings.Step_NameWatermark}" />
                        </StackPanel>
                        <!-- What the module does, next to the step name -->
                        <TextBlock Grid.Column="2" Text="{Binding Description}" TextWrapping="Wrap" FontSize="12" Opacity="0.7"
                                   VerticalAlignment="Center" Margin="16,0" />
                        <ToggleSwitch Grid.Column="3" IsChecked="{Binding IsEnabled}" IsVisible="{Binding !IsSource}"
                                      OnContent="{x:Static res:Strings.Step_Enabled}" OffContent="{x:Static res:Strings.Step_Off}" />
                    </Grid>
                    <Separator />
                    <ContentControl Content="{Binding Settings}" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
    </DockPanel>
</Window>
