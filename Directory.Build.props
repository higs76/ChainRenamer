<Project>
  <!-- Common settings, automatically imported by every project below this folder. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- SemVer: MAJOR.MINOR.PATCH. Each published version also gets a git tag vX.Y.Z. -->
    <Version>0.3.0</Version>
  </PropertyGroup>
</Project>
